# Copy to .env and adjust for your environment.
# No third-party API key is required — the Open Library integration is
# unauthenticated (see docs/02-architecture/adr/0004-openlibrary-integration.md).

NODE_ENV=development
PORT=3000

# Local (non-Docker): matches a Postgres instance you run yourself.
# Docker Compose: overridden to point at the `db` service — see ../docker-compose.yml.
DATABASE_URL="postgresql://shelfie:shelfie@localhost:5432/shelfie?schema=public"

# Must be high-entropy random strings in any non-local environment.
# The placeholders below are intentionally invalid and will fail validation
# in src/config/env.ts if left unchanged outside development.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origin allowed to call this API with credentials (the frontend dev server).
CORS_ORIGIN=http://localhost:5173

OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_TIMEOUT_MS=5000
