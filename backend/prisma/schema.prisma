// Prisma schema for Shelfie.
// Rationale for each model lives in docs/02-architecture/DATABASE_SCHEMA.md —
// this file is the executable source of truth for shape, that doc is the "why."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShelfStatus {
  WANT_TO_READ
  READING
  READ
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  shelfEntries ShelfEntry[]

  @@map("users")
}

model Book {
  id             String   @id @default(uuid())
  openLibraryId  String   @unique
  title          String
  author         String
  coverUrl       String?
  isbn           String?
  publishedYear  Int?
  cachedAt       DateTime @default(now())

  shelfEntries ShelfEntry[]

  @@map("books")
}

model ShelfEntry {
  id          String      @id @default(uuid())
  userId      String
  bookId      String
  status      ShelfStatus
  currentPage Int?
  totalPages  Int?
  rating      Int?
  review      String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([userId, bookId])
  @@index([userId])
  @@map("shelf_entries")
}
